code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_front, diffuse_toon, specular_toon;

uniform float Thickness = 0.10000000149012;
uniform vec4 Albedo : source_color = vec4(0.000000, 0.000000, 0.000000, 1.000000);
uniform sampler2D tex_frg_4;
uniform vec4 LightColour : source_color = vec4(0.828720, 0.008046, 0.471622, 1.000000);
uniform float Dissolve = -1.0;
uniform float Speed = 2.0;
uniform float EdgeSize = 0.10000000149012;



void vertex() {
// Input:2
	vec3 n_out2p0 = NORMAL;


// FloatParameter:3
	float n_out3p0 = Thickness;


// FloatOp:4
	float n_out4p0 = n_out2p0.x * n_out3p0;


// Input:6
	vec3 n_out6p0 = VERTEX;


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out4p0) + n_out6p0;


// Output:0
	VERTEX = n_out7p0;


}

void fragment() {
// ColorParameter:19
	vec4 n_out19p0 = Albedo;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);
	float n_out4p1 = n_out4p0.r;


// ColorParameter:12
	vec4 n_out12p0 = LightColour;


// FloatParameter:18
	float n_out18p0 = Dissolve;


// FloatParameter:8
	float n_out8p0 = Speed;


// FloatOp:9
	float n_out9p0 = n_out18p0 * n_out8p0;


// FloatFunc:6
	float n_out6p0 = sin(n_out9p0);


	float n_out7p0;
// Remap:7
	float n_in7p1 = -1.00000;
	float n_in7p2 = 1.00000;
	float n_in7p3 = 0.00000;
	float n_in7p4 = 1.00000;
	{
		float __input_range = n_in7p2 - n_in7p1;
		float __output_range = n_in7p4 - n_in7p3;
		n_out7p0 = n_in7p3 + __output_range * ((n_out6p0 - n_in7p1) / __input_range);
	}


// FloatParameter:17
	float n_out17p0 = EdgeSize;


// FloatOp:10
	float n_out10p0 = n_out7p0 + n_out17p0;


// Mix:13
	vec4 n_in13p0 = vec4(0.00000, 0.00000, 0.00000, 0.00000);
	vec4 n_out13p0 = mix(n_in13p0, n_out12p0, vec4(n_out10p0));


// Step:11
	vec4 n_out11p0 = step(vec4(n_out4p1), n_out13p0);


// Output:0
	ALBEDO = vec3(n_out19p0.xyz);
	ALPHA = n_out4p0.x;
	EMISSION = vec3(n_out11p0.xyz);
	ALPHA_SCISSOR_THRESHOLD = n_out7p0;


}
"
