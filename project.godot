[layer_names]

3d_physics/layer_1="player_physics"
3d_physics/layer_2="ground"
3d_physics/layer_3="item"
3d_physics/layer_4="enemy_physics"
3d_physics/layer_5="fallzone"
3d_physics/layer_6="hurtbox_player"
3d_physics/layer_7="hitbox_player"
3d_physics/layer_8="hurtbox_enemies"
3d_physics/layer_9="hitbox_enemies"
3d_physics/layer_10="startzone"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=1
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=true
